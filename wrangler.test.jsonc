{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-platform-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "AUTH_MODE": "local-test",
    "LOCAL_AUTH_TOKEN": "test-token",
    "LOCAL_AUTH_USER_ID": "test-user",
    "OWNER_TIMEZONE": "Asia/Kolkata",
    "ALLOWED_ORIGINS": "https://sh.com,https://significanthobbies.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-platform-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
