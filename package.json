{
  "name": "@significant-hobbies/personal-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "types": "wrangler types --include-runtime=false",
    "types:check": "wrangler types --include-runtime=false --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run check && wrangler deploy --tag \"$(git rev-parse HEAD)\"",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "swift:test": "swift test",
    "check": "npm run types:check && npm run typecheck && npm test && npm run deploy:dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260821.1",
    "@types/node": "22.20.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  }
}
